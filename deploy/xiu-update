#!/bin/bash
# =====================================================================
# 快捷更新命令：sudo xiu-update
#   从 GitHub 拉取最新代码 → 重启存档服务 → 重新加载 nginx
#   网页文件直接从 /opt/xiu/web 读取，拉下来就生效。
#   存档在 /var/lib/xiu，更新不会影响玩家数据。
# =====================================================================
set -e
DIR=/opt/xiu
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

echo ">>> 拉取最新代码..."
git -C "$DIR" fetch --depth 1 origin
git -C "$DIR" reset --hard origin/HEAD
git -C "$DIR" log -1 --format="当前版本：%h  %s  (%cd)" --date=format:'%Y-%m-%d %H:%M'

# 更新命令本身有变化：装上新的，重新运行一遍
if ! cmp -s "$DIR/deploy/xiu-update" /usr/local/bin/xiu-update; then
  install -m 755 "$DIR/deploy/xiu-update" /usr/local/bin/xiu-update
  exec /usr/local/bin/xiu-update "$@"
fi

# 网页更新：root 运行的一次性服务 + 只允许 xiu 用户启动它的 sudo 规则
if ! cmp -s "$DIR/deploy/xiu-web-update.service" /etc/systemd/system/xiu-web-update.service; then
  cp "$DIR/deploy/xiu-web-update.service" /etc/systemd/system/xiu-web-update.service
  systemctl daemon-reload
fi
SUDO_RULE="xiu ALL=(root) NOPASSWD: $(command -v systemctl) start --no-block xiu-web-update.service"
if [ "$(cat /etc/sudoers.d/xiu-update 2>/dev/null)" != "$SUDO_RULE" ] && command -v visudo >/dev/null; then
  echo "$SUDO_RULE" > /tmp/xiu-sudo && visudo -cf /tmp/xiu-sudo >/dev/null && install -m 440 /tmp/xiu-sudo /etc/sudoers.d/xiu-update
  rm -f /tmp/xiu-sudo
fi
if ! cmp -s "$DIR/deploy/xiu-server.service" /etc/systemd/system/xiu-server.service; then
  cp "$DIR/deploy/xiu-server.service" /etc/systemd/system/xiu-server.service
  systemctl daemon-reload
fi

echo ">>> 重启存档服务..."
systemctl restart xiu-server
sleep 1
systemctl is-active --quiet xiu-server && echo "存档服务运行中" || { echo "存档服务启动失败："; journalctl -u xiu-server -n 20 --no-pager; exit 1; }

# nginx 配置有更新也一起装（装完检查不通过就还原）
for NGX in /etc/nginx/conf.d/central_vps_users/*/xiuxian.conf /etc/nginx/snippets/xiuxian.conf; do
  [ -f "$NGX" ] || continue
  if ! cmp -s "$DIR/deploy/nginx-xiuxian.conf" "$NGX"; then
    cp "$NGX" "$NGX.bak"; cp "$DIR/deploy/nginx-xiuxian.conf" "$NGX"
    nginx -t >/dev/null 2>&1 && echo "nginx 配置已更新" || { mv "$NGX.bak" "$NGX"; echo "nginx 新配置检查失败，已还原"; }
  fi
done

nginx -t >/dev/null 2>&1 && systemctl reload nginx
echo ">>> 更新完成！刷新网页即可。"
